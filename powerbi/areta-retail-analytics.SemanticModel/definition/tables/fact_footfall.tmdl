	measure 'Average Transaction Value (Selected VAT View) YoY Combo' = [Average Transaction Value (Selected VAT View) Trend Arrow] & " £" & FORMAT ( ABS ( [Average Transaction Value (Selected VAT View) YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Average Transaction Value (Selected VAT View) YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: VAT View
		lineageTag: b1a19fa0-705c-4170-a40d-7b80d5a438ba

