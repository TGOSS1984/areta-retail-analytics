	measure 'Items per Transaction Trend Colour' = IF ( [Items per Transaction YoY %] > 0, "#2E7D32", IF ( [Items per Transaction YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Footfall & Conversion
		lineageTag: 4336905e-b584-4017-9e2f-b84b5c2077dc

	measure 'Items per Transaction YoY Combo' = [Items per Transaction Trend Arrow] & " " & FORMAT ( ABS ( [Items per Transaction YoY] ), "0.00" ) & " (" & FORMAT ( [Items per Transaction YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Footfall & Conversion
		lineageTag: aa5d2ba7-f617-442b-b9ca-a3dbadba942d

	measure 'Average Transaction Value (Selected VAT View)' =
			SWITCH (
			    SELECTEDVALUE ( dim_vat_view[vat_view], "Excluding VAT" ),
			    "Including VAT", DIVIDE ( [Gross Sales inc. VAT (GBP)], [Total Transactions] ),
			    [Average Transaction Value (GBP)]
			)
		formatString: "£"#,0.00
		displayFolder: VAT View
		lineageTag: 6f6aceb9-5a44-4f7e-8219-dd5a53dbdf2e

	measure 'Average Transaction Value (Selected VAT View) LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Average Transaction Value (Selected VAT View)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		displayFolder: VAT View
		lineageTag: 6e566278-9930-4b71-a5c4-5624e546c3da

	measure 'Average Transaction Value (Selected VAT View) YoY (GBP)' = [Average Transaction Value (Selected VAT View)] - [Average Transaction Value (Selected VAT View) LY]
		formatString: "£"#,0.00
		displayFolder: VAT View
		lineageTag: c53e1173-35b6-44ec-af0e-ce7cd6da6d71

	measure 'Average Transaction Value (Selected VAT View) YoY %' = DIVIDE ( [Average Transaction Value (Selected VAT View)] - [Average Transaction Value (Selected VAT View) LY], [Average Transaction Value (Selected VAT View) LY] )
		formatString: 0.0%
		displayFolder: VAT View
		lineageTag: 3288d405-1ee0-4868-bc70-fa5615ef6161

	measure 'Average Transaction Value (Selected VAT View) Trend Arrow' = IF ( [Average Transaction Value (Selected VAT View) YoY %] > 0, "▲", IF ( [Average Transaction Value (Selected VAT View) YoY %] < 0, "▼", "▬" ) )
		displayFolder: VAT View
		lineageTag: 9907544e-c6d5-4dfc-b529-32004d19cb31

	measure 'Average Transaction Value (Selected VAT View) Trend Colour' = IF ( [Average Transaction Value (Selected VAT View) YoY %] > 0, "#2E7D32", IF ( [Average Transaction Value (Selected VAT View) YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: VAT View
