table dq_check_results
	lineageTag: 393b6424-0658-4cc9-8c5d-3af996210bf9

	measure 'DQ Checks Run' = COALESCE ( CALCULATE ( COUNTROWS ( dq_check_results ), dq_check_results[counts_toward_score] = 1 ), 0 )
		formatString: #,0
		lineageTag: 64cbc075-f98f-4713-8e3a-a28bba74fe44
		displayFolder: Data Quality

	measure 'DQ Checks Passed' = COALESCE ( CALCULATE ( COUNTROWS ( dq_check_results ), dq_check_results[counts_toward_score] = 1, dq_check_results[status] = "Pass" ), 0 )
		formatString: #,0
		lineageTag: cb109505-de7c-4288-b3a5-406f5626190a
		displayFolder: Data Quality

	measure 'DQ Checks Warned' = COALESCE ( CALCULATE ( COUNTROWS ( dq_check_results ), dq_check_results[counts_toward_score] = 1, dq_check_results[status] = "Warn" ), 0 )
		formatString: #,0
		lineageTag: dfa3250a-f86d-4b09-8ff7-e66841781746
		displayFolder: Data Quality

	measure 'DQ Checks Failed' = COALESCE ( CALCULATE ( COUNTROWS ( dq_check_results ), dq_check_results[counts_toward_score] = 1, dq_check_results[status] = "Fail" ), 0 )
		formatString: #,0
		lineageTag: dcb03789-9eb4-4c8d-a184-fb67c4a2335f
		displayFolder: Data Quality

	measure 'Data Quality Score' = DIVIDE ( [DQ Checks Passed], [DQ Checks Run] )
		formatString: 0.0%
		lineageTag: 5cf7a3cd-5527-40b5-9a70-62ba91611d9b
		displayFolder: Data Quality

	measure 'DQ Checks Passed Label' = [DQ Checks Passed] & " of " & [DQ Checks Run] & " checks passed"
		lineageTag: 0bbf9839-f7ee-48b8-8c97-daa383ce747b
		displayFolder: Data Quality

	measure 'DQ Overall Status' =
			VAR Failed = [DQ Checks Failed]
			VAR Warned = [DQ Checks Warned]
			RETURN
			    IF (
			        Failed > 0,
			        Failed & IF ( Failed = 1, " check failed", " checks failed" ),
			        IF (
			            Warned > 0,
			            Warned & IF ( Warned = 1, " warning", " warnings" ),
			            "All checks passed"
			        )
			    )
		lineageTag: 1b4dce4e-2695-4407-94ff-399e1d8777e0
		displayFolder: Data Quality

	measure 'DQ Overall Status Colour' = IF ( [DQ Checks Failed] > 0, "#D32F2F", IF ( [DQ Checks Warned] > 0, "#F9A825", "#2E7D32" ) )
		lineageTag: ce3606df-a861-4e01-9e0a-92b16b77ee95
		displayFolder: Data Quality

	measure 'DQ Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( dq_check_results[status] ),
			    "Pass", "#2E7D32",
			    "Warn", "#F9A825",
			    "Fail", "#D32F2F",
			    "Fixed", "#0288D1",
			    "#8D9AA1"
			)
		lineageTag: 1bc07b3e-33c9-4e7d-ac6e-591550416be6
		displayFolder: Data Quality

	measure 'DQ Rows Tested' = SUM ( dq_check_results[rows_tested] )
		formatString: #,0
		lineageTag: eb4f332f-575b-4d91-83e5-4cfd6f37ff72
		displayFolder: Data Quality

	measure 'DQ Rows Failed' = SUM ( dq_check_results[rows_failed] )
		formatString: #,0
		lineageTag: d6848a0b-71c2-4bf0-98c9-20f125f12cc6
		displayFolder: Data Quality

	measure 'DQ Row Pass Rate %' = DIVIDE ( [DQ Rows Tested] - [DQ Rows Failed], [DQ Rows Tested] )
		formatString: 0.00%
		lineageTag: 53ca85b3-8bb7-4b60-915e-3836ea7653d8
		displayFolder: Data Quality

	measure 'DQ Scored Rows Tested' = CALCULATE ( SUM ( dq_check_results[rows_tested] ), dq_check_results[counts_toward_score] = 1 )
		formatString: #,0
		lineageTag: ff635b06-f1be-454d-80ec-3de4706cb747
		displayFolder: Data Quality

	measure 'DQ Raw Rows Received' = CALCULATE ( MAX ( dq_check_results[rows_tested] ), dq_check_results[category] = "Cleaning" )
		formatString: #,0
		lineageTag: fa58abda-eeac-4467-b53b-e71b5e0a7af2
		displayFolder: Data Quality

	measure 'DQ Rows Fixed in Cleaning' = CALCULATE ( SUM ( dq_check_results[rows_failed] ), dq_check_results[category] = "Cleaning" )
		formatString: #,0
		lineageTag: f2e7cfc0-ef4a-4d86-87a3-7e044023f0e3
		displayFolder: Data Quality

	measure 'DQ Source A Value' = SUM ( dq_check_results[source_a_value] )
		formatString: #,0.00
		lineageTag: d099b31a-e69b-49a6-a022-4ad5a2e48672
		displayFolder: Data Quality

	measure 'DQ Source B Value' = SUM ( dq_check_results[source_b_value] )
		formatString: #,0.00
		lineageTag: 84275e2d-5c09-47e6-9367-dad2b06aba57
		displayFolder: Data Quality

	measure 'DQ Recon Variance' = [DQ Source A Value] - [DQ Source B Value]
		formatString: #,0.00;-#,0.00;0.00
		lineageTag: 4e9ea403-a819-4407-b4aa-35f105ca5b4f
		displayFolder: Data Quality

	measure 'DQ Recon Variance %' = DIVIDE ( [DQ Recon Variance], [DQ Source B Value] )
		formatString: 0.0000%
		lineageTag: bd223493-7f62-4ccb-90c0-20d4a60a37ee
		displayFolder: Data Quality

	measure 'DQ Last Audit' = MAXX ( dq_check_results, dq_check_results[run_timestamp] ) & " UTC"
		lineageTag: 1cb638b1-96e8-4a70-89cd-efa89679e07d
		displayFolder: Data Quality

