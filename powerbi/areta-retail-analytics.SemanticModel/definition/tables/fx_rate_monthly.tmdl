table fx_rate_monthly
	lineageTag: a0815869-d969-44ad-934c-433db59fec4c

	column month_start
		dataType: dateTime
		formatString: General Date
		lineageTag: c4f62824-c040-4b77-a61d-8fee22623bfd
		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = Automatic

	column currency_code
		dataType: string
		lineageTag: 712e9531-1861-40d4-8582-ab3f3653a6ca
		summarizeBy: none
		sourceColumn: currency_code

		annotation SummarizationSetBy = Automatic

	column gbp_rate
		dataType: double
		lineageTag: e1d88f96-9cc0-4913-b2b3-ef52cb9e58e8
		summarizeBy: sum
		sourceColumn: gbp_rate

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FX Rate (Selected)' =
			VAR SelectedCcy = SELECTEDVALUE ( dim_currency_view[currency_code], "GBP" )
			VAR RangeStart = MIN ( dim_date[full_date] )
			VAR RangeEnd = MAX ( dim_date[full_date] )
			RETURN
			    IF (
			        SelectedCcy = "GBP",
			        1.0,
			        CALCULATE (
			            AVERAGE ( fx_rate_monthly[gbp_rate] ),
			            fx_rate_monthly[currency_code] = SelectedCcy,
			            fx_rate_monthly[month_start] >= DATE ( YEAR ( RangeStart ), MONTH ( RangeStart ), 1 ),
			            fx_rate_monthly[month_start] <= RangeEnd
			        )
			    )
		formatString: 0.0000
		lineageTag: c857bdd4-4140-4af2-a017-b9d2adf4c117
		displayFolder: Currency View

	partition fx_rate_monthly = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents("C:\Users\tomgo\OneDrive\Documents\vscode-projects\areta-retail-analytics\data\warehouse\fx_rate_monthly.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
				    Source

	annotation PBI_ResultType = Table

