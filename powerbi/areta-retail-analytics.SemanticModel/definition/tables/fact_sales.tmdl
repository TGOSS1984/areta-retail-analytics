	measure 'Net Sales YoY Combo' =
			VAR VatFactor =
				IF (
				    SELECTEDVALUE ( 'VAT View'[VAT View], "Excluding VAT" ) = "Including VAT",
				    DIVIDE ( SUM ( fact_sales[gross_sales_gbp] ), SUM ( fact_sales[net_sales_gbp] ), 1 ),
				    1
				)
			VAR CcyFactor = [FX Rate (Selected)]
			VAR Factor = VatFactor * CcyFactor
			RETURN
			    [Net Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Net Sales YoY (GBP)] * Factor ), "#,0" ) & " (" & FORMAT ( [Net Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: KPI Trend Indicators
		lineageTag: 3492abb1-acc8-46dd-a656-550f60f373d9

