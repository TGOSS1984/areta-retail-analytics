	measure 'Cost of Goods (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[cogs_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: 0472e30d-00fd-4561-b99b-04bf30d65d2b
		displayFolder: Contribution

	measure 'Rent (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[rent_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: 652bffd0-6210-4d19-9cab-f1c9c8b7dc67
		displayFolder: Contribution

	measure 'Staff Costs (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[staff_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: 9850dd08-dcf6-4245-ab65-003b456e104c
		displayFolder: Contribution

	measure 'Utilities (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[utilities_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: c132cf14-fe92-4f2a-a585-ae3b62033699
		displayFolder: Contribution

	measure 'Marketing (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[marketing_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: 94d10f07-8e03-4ebf-837a-ae1ff799c5cf
		displayFolder: Contribution

	measure 'Store Operating Costs (GBP)' = [Rent (GBP)] + [Staff Costs (GBP)] + [Utilities (GBP)] + [Marketing (GBP)]
		formatString: "£"#,0.00
		lineageTag: c5ee857b-8b32-48de-bcd1-a065243f94e4
		displayFolder: Contribution

	measure 'Gross Contribution (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[gross_contribution_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: 492bcbdd-b5af-4478-ae6c-9d8bfd80d863
		displayFolder: Contribution

	measure 'Gross Contribution %' =
			CALCULATE (
			    DIVIDE ( [Gross Contribution (GBP)], SUM ( fact_store_finance[net_sales_gbp] ) ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: 0.0%
		lineageTag: d704bc3c-2193-43cb-9bba-0fac26edc764
		displayFolder: Contribution

	measure 'Head Office Allocation (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[head_office_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: da9be2f5-ad3b-495a-b31c-18d69d2592d0
		displayFolder: Contribution

	measure 'Net Contribution (GBP)' =
			CALCULATE (
			    SUM ( fact_store_finance[net_contribution_gbp] ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: "£"#,0.00
		lineageTag: a2da6bdb-0b07-41c2-837b-280513ac1cf5
		displayFolder: Contribution

	measure 'Net Contribution %' =
			CALCULATE (
			    DIVIDE ( [Net Contribution (GBP)], SUM ( fact_store_finance[net_sales_gbp] ) ),
			    USERELATIONSHIP ( dim_date[business_period_label], dim_period[business_period_label] )
			)
		formatString: 0.0%
		lineageTag: 1346e55f-183f-423f-af22-a98fc27169bd
		displayFolder: Contribution

	measure 'Net Contribution LY' =
			CALCULATE (
			    [Net Contribution (GBP)],
			    FILTER ( ALL ( dim_period[business_year] ), dim_period[business_year] = MAX ( dim_period[business_year] ) - 1 )
			)
		formatString: "£"#,0.00
		lineageTag: b0a4dab3-2f93-4047-922f-18b5fcf768de
		displayFolder: Contribution

	measure 'Net Contribution YoY (GBP)' = [Net Contribution (GBP)] - [Net Contribution LY]
		formatString: "£"#,0.00
		lineageTag: ae481c5c-ac3c-463f-834f-64df421cfc37
		displayFolder: Contribution

	measure 'Net Contribution YoY %' = DIVIDE ( [Net Contribution (GBP)] - [Net Contribution LY], [Net Contribution LY] )
		formatString: 0.0%
		lineageTag: 9922ed4f-4b12-4879-be0e-c314209163c7
		displayFolder: Contribution

	measure 'Net Contribution Trend Arrow' = IF ( [Net Contribution YoY %] > 0, "▲", IF ( [Net Contribution YoY %] < 0, "▼", "▬" ) )
		lineageTag: 454045ee-a413-4ab8-83d6-95c2132ab3ba
		displayFolder: Contribution

	measure 'Net Contribution Trend Colour' = IF ( [Net Contribution YoY %] > 0, "#2E7D32", IF ( [Net Contribution YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		lineageTag: 0a1e6db1-c282-48c2-bcf6-10dc86fde39a
		displayFolder: Contribution

	measure 'Net Contribution YoY Combo' = [Net Contribution Trend Arrow] & " £" & FORMAT ( ABS ( [Net Contribution YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Net Contribution YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 2708d09f-bb2c-4c0a-abb5-d745a8073def
		displayFolder: Contribution

	measure 'Gross Contribution LY' =
			CALCULATE (
			    [Gross Contribution %],
			    FILTER ( ALL ( dim_period[business_year] ), dim_period[business_year] = MAX ( dim_period[business_year] ) - 1 )
			)
		formatString: 0.0%
		lineageTag: ac19d75b-97c6-44dc-9ad1-bbb2ac3dfcd0
		displayFolder: Contribution

	measure 'Gross Contribution YoY (pp)' = [Gross Contribution %] - [Gross Contribution LY]
		formatString: 0.0%
		lineageTag: e0111c3a-9a93-4813-b6eb-5c2c51961fda
		displayFolder: Contribution

	measure 'Gross Contribution Trend Arrow' = IF ( [Gross Contribution YoY (pp)] > 0, "▲", IF ( [Gross Contribution YoY (pp)] < 0, "▼", "▬" ) )
		lineageTag: 49716b39-0f7d-430a-8826-a22d2d5380fa
		displayFolder: Contribution

	measure 'Gross Contribution Trend Colour' = IF ( [Gross Contribution YoY (pp)] > 0, "#2E7D32", IF ( [Gross Contribution YoY (pp)] < 0, "#D32F2F", "#8D9AA1" ) )
		lineageTag: 095911f0-bc5c-45fe-87a1-f6c71ee398a8
		displayFolder: Contribution

	measure 'Gross Contribution YoY Combo' = [Gross Contribution Trend Arrow] & " " & FORMAT ( [Gross Contribution YoY (pp)], "+0.0pp;-0.0pp;0.0pp" )
		lineageTag: 187620f6-ded9-4e02-9b69-4913608756d6
		displayFolder: Contribution

	measure 'Net Contribution Pct LY' =
			CALCULATE (
			    [Net Contribution %],
			    FILTER ( ALL ( dim_period[business_year] ), dim_period[business_year] = MAX ( dim_period[business_year] ) - 1 )
			)
		formatString: 0.0%
		lineageTag: 50b1f682-b87f-48b3-9e23-103c5828f963
		displayFolder: Contribution

	measure 'Net Contribution Pct YoY (pp)' = [Net Contribution %] - [Net Contribution Pct LY]
		formatString: 0.0%
		lineageTag: c3cd8266-bf48-4f8a-a0c5-27103d3e59cb
		displayFolder: Contribution

	measure 'Net Contribution Pct Trend Arrow' = IF ( [Net Contribution Pct YoY (pp)] > 0, "▲", IF ( [Net Contribution Pct YoY (pp)] < 0, "▼", "▬" ) )
		lineageTag: 20e07024-0015-4c15-8886-133e94da9dd2
		displayFolder: Contribution

	measure 'Net Contribution Pct Trend Colour' = IF ( [Net Contribution Pct YoY (pp)] > 0, "#2E7D32", IF ( [Net Contribution Pct YoY (pp)] < 0, "#D32F2F", "#8D9AA1" ) )
		lineageTag: 931cf527-bc41-40c5-90a6-b876006fdda7
		displayFolder: Contribution

	measure 'Net Contribution Pct YoY Combo' = [Net Contribution Pct Trend Arrow] & " " & FORMAT ( [Net Contribution Pct YoY (pp)], "+0.0pp;-0.0pp;0.0pp" )
		lineageTag: 41cc80dd-c967-4124-ae2a-3c05e726e291
		displayFolder: Contribution

	measure 'Store Operating Costs LY' =
