	measure 'Net Sales (GBP)' = SUM ( fact_sales[net_sales_gbp] )
		formatString: "£"#,0.00
		lineageTag: 024b0bd8-fd47-487c-ac8d-b517b530f46e
		displayFolder: Sales & Margin

	measure 'Gross Cost (GBP)' = SUM ( fact_sales[cost_gbp] )
		formatString: "£"#,0.00
		lineageTag: 508fbfbf-91a1-4373-8171-4fa279a7c6cd
		displayFolder: Sales & Margin

	measure 'Gross Profit (GBP)' = [Net Sales (GBP)] - [Gross Cost (GBP)]
		formatString: "£"#,0.00
		lineageTag: 157d84a4-ed4b-436d-87c6-ffc8d787113a
		displayFolder: Sales & Margin

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit (GBP)], [Net Sales (GBP)] )
		formatString: 0.0%
		lineageTag: 400ea95f-f6bb-4b81-a60a-28cf8ebb31ff
		displayFolder: Sales & Margin

	measure 'Gross Units Sold' = CALCULATE ( SUM ( fact_sales[quantity] ), fact_sales[is_return] = FALSE )
		formatString: #,0
		lineageTag: e1695d36-c0ba-45ac-8d05-38c4ef2c7f7a
		displayFolder: Sales & Margin

	measure 'Units Returned' = CALCULATE ( -SUM ( fact_sales[quantity] ), fact_sales[is_return] = TRUE )
		formatString: #,0
		lineageTag: 1de5cd32-ab5a-4efc-b06f-289d92dbb8bd
		displayFolder: Sales & Margin

	measure 'Return Rate %' = DIVIDE ( [Units Returned], [Gross Units Sold] )
		formatString: 0.0%
		lineageTag: d0b36d98-965f-49e1-9d7b-ee8595317432
		displayFolder: Sales & Margin

	measure 'Net Units Sold' = SUM ( fact_sales[quantity] )
		formatString: #,0
		lineageTag: 1a48ea54-8db6-4310-a61e-66cb71ff1061
		displayFolder: Sales & Margin

	measure 'Full Price Sales (GBP)' = CALCULATE ( [Net Sales (GBP)], fact_sales[promo_id] = "PROMO0000" )
		formatString: "£"#,0.00
		lineageTag: 384d3bdb-b44c-4b0c-b76f-a1f9bd940746
		displayFolder: Sales & Margin

	measure 'Full Price Mix %' = DIVIDE ( [Full Price Sales (GBP)], [Net Sales (GBP)] )
		formatString: 0.0%
		lineageTag: 9bcaeade-53b1-4ab1-bc9b-2659f9ba5575
		displayFolder: Sales & Margin

	measure 'Multi-buy Sales (GBP)' = CALCULATE ( [Net Sales (GBP)], LEFT ( fact_sales[promo_id], 9 ) = "MULTIBUY-" )
		formatString: "£"#,0.00
		lineageTag: 8b70caf7-ab7d-4b4e-8e74-fa851ce7195a
		displayFolder: Sales & Margin

	measure 'Multi-buy Mix %' = DIVIDE ( [Multi-buy Sales (GBP)], [Net Sales (GBP)] )
		formatString: 0.0%
		lineageTag: d3f9e44d-4d8d-478e-bf99-81e099813359
		displayFolder: Sales & Margin

	measure 'VAT (GBP)' = SUM ( fact_sales[vat_gbp] )
		formatString: "£"#,0.00
		lineageTag: f2c73f4e-e774-4c33-948d-a7c825818f88
		displayFolder: Sales & Margin

	measure 'Gross Sales inc. VAT (GBP)' = SUM ( fact_sales[gross_sales_gbp] )
		formatString: "£"#,0.00
		lineageTag: 66bc5a73-c9b8-4358-b9fe-12f5e6dc4f00
		displayFolder: Sales & Margin

	measure 'Net Sales LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Net Sales (GBP)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		lineageTag: efd2b77e-e632-4382-876f-26b475aba94c
		displayFolder: Time Intelligence

	measure 'Net Sales YoY %' = DIVIDE ( [Net Sales (GBP)] - [Net Sales LY], [Net Sales LY] )
		formatString: 0.0%
		lineageTag: 01d3df6f-632c-471c-b17b-73bc1d45cc44
		displayFolder: Time Intelligence

	measure 'Net Sales YoY (GBP)' = [Net Sales (GBP)] - [Net Sales LY]
		formatString: "£"#,0.00
		lineageTag: 971f3181-8543-400c-b2f0-b5246d46bc8e
		displayFolder: Time Intelligence

	measure 'Net Units Sold YoY (Units)' = [Net Units Sold] - [Net Units Sold LY]
		formatString: #,0
		lineageTag: b69c4175-effe-4914-92ca-9d22351967f9
		displayFolder: Time Intelligence

	measure 'Retail Sales YoY (GBP)' = [Retail Sales (GBP)] - [Retail Sales LY]
		formatString: "£"#,0.00
		lineageTag: 553430a0-846e-414c-96e8-009ab039faf8
		displayFolder: Time Intelligence

	measure 'Concession Sales YoY (GBP)' = [Concession Sales (GBP)] - [Concession Sales LY]
		formatString: "£"#,0.00
		lineageTag: b9315390-e2e5-483e-932e-ddc4efedbed4
		displayFolder: Time Intelligence

	measure 'Online Sales YoY (GBP)' = [Online Sales (GBP)] - [Online Sales LY]
		formatString: "£"#,0.00
		lineageTag: 62e3d59a-00ca-4c63-a578-d03c03a42b99
		displayFolder: Time Intelligence

	measure 'Net Sales YoY Combo' = [Net Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Net Sales YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Net Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 3492abb1-acc8-46dd-a656-550f60f373d9
		displayFolder: KPI Trend Indicators

	measure 'Net Units Sold YoY Combo' = [Net Units Sold Trend Arrow] & " " & FORMAT ( ABS ( [Net Units Sold YoY (Units)] ), "#,0" ) & " (" & FORMAT ( [Net Units Sold YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 69faa9fc-e794-4561-8386-f06600fbbbb2
		displayFolder: KPI Trend Indicators

	measure 'Retail Sales YoY Combo' = [Retail Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Retail Sales YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Retail Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 947fdd56-0111-4c33-9fdd-b284661069e6
		displayFolder: KPI Trend Indicators

	measure 'Concession Sales YoY Combo' = [Concession Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Concession Sales YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Concession Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: ea7ac2d9-d4d4-434d-82cb-9a6bde7ea015
