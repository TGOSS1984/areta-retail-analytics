table fact_footfall
	lineageTag: 0a1f02ad-fb55-4f6e-b8a1-c31be2d00ec5

	measure 'Total Footfall' = SUM ( fact_footfall[footfall] )
		formatString: #,0
		displayFolder: Footfall & Conversion
		lineageTag: be58b254-a3b9-4a2f-a2da-797ce3ad6e28

	measure 'Total Transactions' = SUM ( fact_footfall[transactions] )
		formatString: #,0
		displayFolder: Footfall & Conversion
		lineageTag: c65b6fdc-6c5a-4306-beba-cea243b06bf8

	measure 'Conversion Rate %' = DIVIDE ( [Total Transactions], [Total Footfall] )
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: 802d5a98-2a16-43e5-9c81-631ae8271877

	measure 'Items per Transaction' = DIVIDE ( [Gross Units Sold], [Total Transactions] )
		formatString: #,0.00
		displayFolder: Footfall & Conversion
		lineageTag: 860f715b-30b2-41dc-9894-683eeae0cb68

	measure 'Average Transaction Value (GBP)' = DIVIDE ( [Net Sales (GBP)], [Total Transactions] )
		formatString: "£"#,0.00
		displayFolder: Footfall & Conversion
		lineageTag: 219d02b0-f234-46e4-b6b9-87542eed9edb

	measure 'Total Footfall LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Total Footfall],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: #,0
		displayFolder: Footfall & Conversion
		lineageTag: 882f7f95-23df-44ed-926b-a0d674baaad9

	measure 'Total Footfall YoY' = [Total Footfall] - [Total Footfall LY]
		formatString: #,0
		displayFolder: Footfall & Conversion
		lineageTag: a39f824c-3dd0-4664-98d3-e250481ee46d

	measure 'Total Footfall YoY %' = DIVIDE ( [Total Footfall] - [Total Footfall LY], [Total Footfall LY] )
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: bcb19d07-cdb4-41af-b7c4-e8d87f573807

	measure 'Total Footfall Trend Arrow' = IF ( [Total Footfall YoY %] > 0, "▲", IF ( [Total Footfall YoY %] < 0, "▼", "▬" ) )
		displayFolder: Footfall & Conversion
		lineageTag: 68d8b966-19dc-4f0a-bfc7-e37cc8526b57

	measure 'Total Footfall Trend Colour' = IF ( [Total Footfall YoY %] > 0, "#2E7D32", IF ( [Total Footfall YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Footfall & Conversion
		lineageTag: 778c16d8-5497-4fe6-97ff-cccc384c0131

	measure 'Total Footfall YoY Combo' = [Total Footfall Trend Arrow] & " " & FORMAT ( ABS ( [Total Footfall YoY] ), "#,0" ) & " (" & FORMAT ( [Total Footfall YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Footfall & Conversion
		lineageTag: 388bc1c2-b098-4503-b16c-04b0a71f1dfd

	measure 'Average Transaction Value LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Average Transaction Value (GBP)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		displayFolder: Footfall & Conversion
		lineageTag: e2af10da-a2e1-440b-b0d6-731b9d147468

	measure 'Average Transaction Value YoY (GBP)' = [Average Transaction Value (GBP)] - [Average Transaction Value LY]
		formatString: "£"#,0.00
		displayFolder: Footfall & Conversion
		lineageTag: ea35da8f-91ea-40ab-bfc6-c75cea58ea67

	measure 'Average Transaction Value YoY %' = DIVIDE ( [Average Transaction Value (GBP)] - [Average Transaction Value LY], [Average Transaction Value LY] )
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: b7b7f840-6e88-4585-b17d-92a693b77245

	measure 'Average Transaction Value Trend Arrow' = IF ( [Average Transaction Value YoY %] > 0, "▲", IF ( [Average Transaction Value YoY %] < 0, "▼", "▬" ) )
		displayFolder: Footfall & Conversion
		lineageTag: ac638baa-5d56-495d-b4d2-6a12254c91e8

	measure 'Average Transaction Value Trend Colour' = IF ( [Average Transaction Value YoY %] > 0, "#2E7D32", IF ( [Average Transaction Value YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Footfall & Conversion
		lineageTag: 45e6cff5-9e79-45fe-b049-5a3af13b1741

	measure 'Average Transaction Value YoY Combo' = [Average Transaction Value Trend Arrow] & " £" & FORMAT ( ABS ( [Average Transaction Value YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Average Transaction Value YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Footfall & Conversion
		lineageTag: 84ab7449-c5d1-4330-bed5-160e01d4422c

	measure 'Conversion Rate % LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Conversion Rate %],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: 90de8917-f675-4458-8f08-3b8fe4fce801

	measure 'Conversion Rate YoY (pp)' = [Conversion Rate %] - [Conversion Rate % LY]
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: e970ba61-3160-45bf-9822-7228f6cd574e

	measure 'Conversion Rate Trend Arrow' = IF ( [Conversion Rate YoY (pp)] > 0, "▲", IF ( [Conversion Rate YoY (pp)] < 0, "▼", "▬" ) )
		displayFolder: Footfall & Conversion
		lineageTag: e10657d1-d570-48d9-846e-b84c4f9e295e

	measure 'Conversion Rate Trend Colour' = IF ( [Conversion Rate YoY (pp)] > 0, "#2E7D32", IF ( [Conversion Rate YoY (pp)] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Footfall & Conversion
		lineageTag: 9cb15783-b45c-46d8-be3d-c923d5e97555

	measure 'Conversion Rate YoY Combo' = [Conversion Rate Trend Arrow] & " " & FORMAT ( [Conversion Rate YoY (pp)], "+0.0pp;-0.0pp;0.0pp" )
		displayFolder: Footfall & Conversion
		lineageTag: 96c7a8f7-5b7c-451a-bc25-efd4958b7b17

	measure 'Items per Transaction LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Items per Transaction],
