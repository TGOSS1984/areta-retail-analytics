		displayFolder: Time Intelligence
		lineageTag: ce0f3082-ff9d-4c8a-acc3-2abb72c708da

	measure 'Add to Basket Rate Trend Colour' = IF ( [Add to Basket Rate YoY (pp)] > 0, "#2E7D32", IF ( [Add to Basket Rate YoY (pp)] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Time Intelligence
		lineageTag: 4520bf0d-080b-4a75-a684-7856e0711153

	measure 'Add to Basket Rate YoY Combo' = [Add to Basket Rate Trend Arrow] & " " & FORMAT ( [Add to Basket Rate YoY (pp)] * 100, "+0.0pp;-0.0pp;0.0pp" )
		displayFolder: Time Intelligence
		lineageTag: 8792b9fa-9031-4f17-9f18-0fdac40553ae

	measure 'Basket Abandonment LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			VAR RelevantWeekdays = VALUES ( dim_date[day_of_week_num] )
			RETURN
			    CALCULATE (
			        [Basket Abandonment %],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] ),
			        TREATAS ( RelevantWeekdays, dim_date[day_of_week_num] )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: a707aff8-9014-4d6c-83e8-36d0c72cd7f9

	measure 'Basket Abandonment YoY (pp)' = [Basket Abandonment %] - [Basket Abandonment LY]
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: d6c6c291-98bf-486c-99b2-ad581ecc52cd

	measure 'Basket Abandonment Trend Arrow' = IF ( [Basket Abandonment YoY (pp)] > 0, "▲", IF ( [Basket Abandonment YoY (pp)] < 0, "▼", "▬" ) )
		displayFolder: Time Intelligence
		lineageTag: 8e3c326a-14ed-463b-b704-f6eb5e984f0e

	/// Reversed: abandonment going down is good news, so down is green and up is red.
	/// The arrow still points the way the number moved.
	measure 'Basket Abandonment Trend Colour' = IF ( [Basket Abandonment YoY (pp)] < 0, "#2E7D32", IF ( [Basket Abandonment YoY (pp)] > 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Time Intelligence
		lineageTag: eeed78e9-0e86-4102-9b33-d27833ad386a

	measure 'Basket Abandonment YoY Combo' = [Basket Abandonment Trend Arrow] & " " & FORMAT ( [Basket Abandonment YoY (pp)] * 100, "+0.0pp;-0.0pp;0.0pp" )
		displayFolder: Time Intelligence
		lineageTag: 1bc10cb3-2ee2-486d-a807-27b8724355e4

	measure 'Checkout Abandonment LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			VAR RelevantWeekdays = VALUES ( dim_date[day_of_week_num] )
			RETURN
			    CALCULATE (
			        [Checkout Abandonment %],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] ),
			        TREATAS ( RelevantWeekdays, dim_date[day_of_week_num] )
			    )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 96307050-79af-4ef0-9477-e41fd3bc141e

	measure 'Checkout Abandonment YoY (pp)' = [Checkout Abandonment %] - [Checkout Abandonment LY]
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 1145d052-5af6-447c-b42a-e3f76527e63d

	measure 'Checkout Abandonment Trend Arrow' = IF ( [Checkout Abandonment YoY (pp)] > 0, "▲", IF ( [Checkout Abandonment YoY (pp)] < 0, "▼", "▬" ) )
		displayFolder: Time Intelligence
		lineageTag: 436217c5-3d1a-4905-9c57-c37cbe40f33f

	/// Reversed: abandonment going down is good news, so down is green and up is red.
	/// The arrow still points the way the number moved.
	measure 'Checkout Abandonment Trend Colour' = IF ( [Checkout Abandonment YoY (pp)] < 0, "#2E7D32", IF ( [Checkout Abandonment YoY (pp)] > 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Time Intelligence
		lineageTag: c77c4cd5-4ddc-4983-8ef1-ec5ecf0d6422

	measure 'Checkout Abandonment YoY Combo' = [Checkout Abandonment Trend Arrow] & " " & FORMAT ( [Checkout Abandonment YoY (pp)] * 100, "+0.0pp;-0.0pp;0.0pp" )
		displayFolder: Time Intelligence
		lineageTag: 73f01a74-1ebb-4b41-ad37-3939f24e6804

	/// Feeds the native funnel visual: stage_name from dim_funnel_stage on Category, this on
	/// Values. Same idea as the P&L bridge. A disconnected table of stages gives proper
	/// names and a fixed order, which putting five measures straight into the visual doesn't.
	measure 'Funnel Value' =
			SWITCH (
			    SELECTEDVALUE ( dim_funnel_stage[stage_name] ),
			    "Sessions", [Total Sessions],
			    "Viewed a product", [Product View Sessions],
			    "Added to basket", [Basket Sessions],
			    "Reached checkout", [Checkout Sessions],
			    "Ordered", [Order Sessions]
			)
		formatString: #,0
		displayFolder: Funnel
		lineageTag: 44dd9a9a-abaf-41a8-9c9d-24c7075ee3b5

	/// How many of the stage before got this far. For the funnel's tooltip.
	measure 'Funnel % of Previous Stage' =
			VAR Stage = SELECTEDVALUE ( dim_funnel_stage[stage_order] )
			VAR ThisStage = [Funnel Value]
			VAR PreviousStage =
			    CALCULATE ( [Funnel Value], REMOVEFILTERS ( dim_funnel_stage ), dim_funnel_stage[stage_order] = Stage - 1 )
			RETURN
			    IF ( Stage > 1, DIVIDE ( ThisStage, PreviousStage ) )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: 26679fc0-d66c-4836-a9a0-7dbbd2f6a5f3

	/// Each stage as a share of all sessions. The funnel visual shows this as its
	/// "% of first" on its own, but having it as a measure means tooltips and tables get it too.
	measure 'Funnel % of Sessions' = DIVIDE ( [Funnel Value], [Total Sessions] )
		formatString: 0.0%
		displayFolder: Funnel
		lineageTag: f2d0928f-dab0-4cad-a9b7-0f360e63675f

