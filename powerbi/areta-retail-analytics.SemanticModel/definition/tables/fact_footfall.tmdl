		formatString: #,0.00
		displayFolder: Footfall & Conversion
		lineageTag: f8955e8b-026f-42bf-864f-299b32f1fb53

	measure 'Items per Transaction YoY' = [Items per Transaction] - [Items per Transaction LY]
		formatString: #,0.00
		displayFolder: Footfall & Conversion
		lineageTag: 10dc7d57-f169-4d64-bbdb-4e651f91e7ed

	measure 'Items per Transaction YoY %' = DIVIDE ( [Items per Transaction] - [Items per Transaction LY], [Items per Transaction LY] )
		formatString: 0.0%
		displayFolder: Footfall & Conversion
		lineageTag: 1fca8c5d-14ed-4d5f-b1d1-c7043b92eb92

	measure 'Items per Transaction Trend Arrow' = IF ( [Items per Transaction YoY %] > 0, "▲", IF ( [Items per Transaction YoY %] < 0, "▼", "▬" ) )
