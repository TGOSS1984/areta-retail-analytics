	measure 'Net Sales (Selected VAT View) Target' =
			SWITCH (
			    SELECTEDVALUE ( dim_vat_view[vat_view], "Excluding VAT" ),
			    "Including VAT", [Target Net Sales (GBP)] * [VAT Multiplier],
			    [Target Net Sales (GBP)]
			)
		formatString: "£"#,0.00
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Variance (GBP)' =
			[Net Sales (Selected VAT View)] - [Net Sales (Selected VAT View) Target]
		formatString: "£"#,0.00
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Variance %' =
			DIVIDE ( [Net Sales (Selected VAT View) Target Variance (GBP)], [Net Sales (Selected VAT View) Target] )
		formatString: 0.0%
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Achievement %' =
			DIVIDE ( [Net Sales (Selected VAT View)], [Net Sales (Selected VAT View) Target] )
		formatString: 0.0%
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Trend Arrow' =
			IF ( [Net Sales (Selected VAT View) Target Variance %] > 0, "▲", IF ( [Net Sales (Selected VAT View) Target Variance %] < 0, "▼", "▬" ) )
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Trend Colour' =
			IF ( [Net Sales (Selected VAT View) Target Variance %] > 0, "#2E7D32", IF ( [Net Sales (Selected VAT View) Target Variance %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Target Combo' =
			[Net Sales (Selected VAT View) Target Trend Arrow] & " £" & FORMAT ( ABS ( [Net Sales (Selected VAT View) Target Variance (GBP)] ), "#,0" ) & " (" & FORMAT ( [Net Sales (Selected VAT View) Target Variance %], "+0.0%;-0.0%;0.0%" ) & " to target)"
		displayFolder: VAT View

	measure 'Target Net Sales (GBP), Any Grain' =
			SUMX (
			    dim_date,
			    VAR ThisPeriodLabel = dim_date[business_period_label]
			    VAR ThisPeriodNumber = dim_date[business_period_number]
			    VAR ThisBusinessYear = dim_date[business_year]
			    VAR ThisDayName = dim_date[day_name]
			    VAR PeriodTarget =
			        CALCULATE (
			            [Target Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR PriorYearDayNameActual =
			        CALCULATE (
			            [Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR PriorYearPeriodActual =
			        CALCULATE (
			            [Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1
			        )
			    VAR PriorYearDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR ThisPeriodDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR DayWeight =
			        IF (
			            PriorYearPeriodActual > 0,
			            DIVIDE ( PriorYearDayNameActual, PriorYearPeriodActual ),
			            DIVIDE ( 1, ThisPeriodDayCount )
			        )
			    VAR AllocatedForDayName = PeriodTarget * DayWeight
			    RETURN
			        DIVIDE ( AllocatedForDayName, IF ( PriorYearPeriodActual > 0, PriorYearDayCount, 1 ) )
			)
		formatString: "£"#,0.00
		lineageTag: 0a03efe2-7c9a-4ebc-b7d7-5b97ac36cd70
		displayFolder: Targets (Any Grain)

	measure 'Net Sales Target Variance (Any Grain, GBP)' =
			[Net Sales (GBP)] - [Target Net Sales (GBP), Any Grain]
		formatString: "£"#,0.00
		lineageTag: 14c9ea3b-5294-4622-a7b4-e4966f251494
		displayFolder: Targets (Any Grain)

