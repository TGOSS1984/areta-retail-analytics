	measure 'Gross Profit Target Combo' =
			VAR CcyFactor = [FX Rate (Selected)]
			VAR Factor = CcyFactor
			RETURN
			    [Gross Profit Target Trend Arrow] & " £" & FORMAT ( ABS ( [Gross Profit Target Variance (GBP)] * Factor ), "#,0" ) & " (" & FORMAT ( [Gross Profit Target Variance %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Targets
		lineageTag: 41d87a42-baed-4447-943f-feb35e4323cd

	measure 'Target Gross Profit (GBP), Any Grain' =
			// Gross profit target follows the NET SALES weekday curve (the pattern from last year), so the
			// implied margin % is the target margin of that period on every day, and the days sum back to the period target.
			SUMX (
			    dim_date,
			    VAR ThisPeriodLabel = dim_date[business_period_label]
			    VAR ThisPeriodNumber = dim_date[business_period_number]
			    VAR ThisBusinessYear = dim_date[business_year]
			    VAR ThisDayName = dim_date[day_name]
			    VAR PeriodTarget =
			        CALCULATE (
			            [Target Gross Profit (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR PriorYearDayNameActual =
			        CALCULATE (
			            [Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR PriorYearPeriodActual =
			        CALCULATE (
			            [Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1
			        )
			    VAR PriorYearDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR ThisPeriodDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR DayWeight =
			        IF (
			            PriorYearPeriodActual > 0,
			            DIVIDE ( PriorYearDayNameActual, PriorYearPeriodActual ),
			            DIVIDE ( 1, ThisPeriodDayCount )
			        )
			    VAR AllocatedForDayName = PeriodTarget * DayWeight
			    RETURN
			        DIVIDE ( AllocatedForDayName, IF ( PriorYearPeriodActual > 0, PriorYearDayCount, 1 ) )
			)
		formatString: "£"#,0.00
		displayFolder: Targets (Any Grain)
		lineageTag: 6e082f08-b944-470b-be2c-018faea0d3c3

	measure 'Gross Profit Target Variance (Any Grain, GBP)' = [Gross Profit (GBP)] - [Target Gross Profit (GBP), Any Grain]
		formatString: "£"#,0.00
		displayFolder: Targets (Any Grain)
		lineageTag: f04c66ac-9bac-4534-95f7-db8fad224404

	measure 'Gross Profit Target Variance % (Any Grain)' = DIVIDE ( [Gross Profit Target Variance (Any Grain, GBP)], [Target Gross Profit (GBP), Any Grain] )
