	measure 'Online Sales YoY Combo' = [Online Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Online Sales YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Online Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 52c2c241-1f3c-44b8-a248-beeae31d99ae
		displayFolder: KPI Trend Indicators

	measure 'Gross Margin YoY Combo' = [Gross Margin Trend Arrow] & " " & FORMAT ( [Gross Margin YoY (pp)], "+0.0pp;-0.0pp;0.0pp" )
		lineageTag: 06cdde71-0829-48d2-ae84-79c49813baa1
		displayFolder: KPI Trend Indicators

	measure 'Gross Profit LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Gross Profit (GBP)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		lineageTag: 82cff70f-a397-4d42-830b-c4136ae97da5
