	measure 'Stock Units' = SUM ( fact_stock_snapshot[stock_units] )
		formatString: #,0
		lineageTag: 11fa61c2-8292-4931-a162-4cdee5113a2c
		displayFolder: Stock

	measure 'Stock Value (Cost, GBP)' = SUM ( fact_stock_snapshot[stock_value_cost_gbp] )
		formatString: "£"#,0.00
		lineageTag: c26d5a47-5e69-493c-b37e-cf34ee65d6de
		displayFolder: Stock

	measure 'Stock Value (Retail, GBP)' = SUM ( fact_stock_snapshot[stock_value_retail_gbp] )
		formatString: "£"#,0.00
		lineageTag: e57fe0f5-aaf9-469b-a126-b4179b595b28
		displayFolder: Stock

	measure 'Avg Weekly Sales (Units)' = DIVIDE ( [Gross Units Sold], DISTINCTCOUNT ( dim_date[business_week_number] ) )
		formatString: #,0.00
		lineageTag: 549e2729-ead2-44c3-b426-2da47fcccdfa
		displayFolder: Stock

	measure 'Weeks of Cover' = DIVIDE ( [Stock Units], [Avg Weekly Sales (Units)] )
		formatString: #,0.00
		lineageTag: 1b643a25-70bc-45a4-ac9f-722565900628
		displayFolder: Stock

	measure 'Stock Units LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Stock Units],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: #,0
		lineageTag: ad5ecffe-37b3-4bcb-9241-49d5e03e8eaf
		displayFolder: Stock

	measure 'Stock Units YoY' = [Stock Units] - [Stock Units LY]
		formatString: #,0
		lineageTag: 7b3e5772-e9f5-4727-a52a-5e9547037b4b
		displayFolder: Stock

	measure 'Stock Units YoY %' = DIVIDE ( [Stock Units] - [Stock Units LY], [Stock Units LY] )
		formatString: 0.0%
		lineageTag: c0248d57-797e-458b-ae9b-51dc737cec4a
		displayFolder: Stock

	measure 'Stock Units Trend Arrow' = IF ( [Stock Units YoY %] > 0, "▲", IF ( [Stock Units YoY %] < 0, "▼", "▬" ) )
		lineageTag: da4a5766-5f51-41af-a168-c138cabcc92d
		displayFolder: Stock

	measure 'Stock Units Trend Colour' = IF ( [Stock Units YoY %] > 0, "#2E7D32", IF ( [Stock Units YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		lineageTag: e130d52e-62f2-4865-9600-05221b329b50
		displayFolder: Stock

	measure 'Stock Units YoY Combo' = [Stock Units Trend Arrow] & " " & FORMAT ( ABS ( [Stock Units YoY] ), "#,0.00" ) & " (" & FORMAT ( [Stock Units YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: fde48161-ca45-4724-94b5-d8f4499fd953
		displayFolder: Stock

	measure 'Stock Value Cost LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Stock Value (Cost, GBP)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		lineageTag: c1e63521-edee-4933-974e-6eb03d211423
		displayFolder: Stock

	measure 'Stock Value Cost YoY (GBP)' = [Stock Value (Cost, GBP)] - [Stock Value Cost LY]
		formatString: "£"#,0.00
		lineageTag: b610739a-d689-47bd-81e6-8bcd750c2d45
