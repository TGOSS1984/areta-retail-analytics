				    1
				)
			VAR CcyFactor = [FX Rate (Selected)]
			VAR Factor = VatFactor * CcyFactor
			RETURN
			    [Full Price Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Full Price Sales YoY (GBP)] * Factor ), "#,0" ) & " (" & FORMAT ( [Full Price Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
