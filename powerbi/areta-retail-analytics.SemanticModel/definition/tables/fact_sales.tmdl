	measure 'Style Pareto Cumulative Sales (GBP)' =
			VAR CurrentRank = [Style Pareto Rank]
			RETURN
			    CALCULATE (
			        [Net Sales (GBP)],
			        FILTER (
			            ALL ( dim_product[style_code] ),
			            [Style Pareto Rank] <= CurrentRank
			        )
			    )
		formatString: "£"#,0.00
		lineageTag: cf71f7b9-5bf2-44df-bc0e-f1174d2d42c1
		displayFolder: Pareto Analysis

	measure 'Style Pareto Cumulative %' =
