table fact_digital_targets
	lineageTag: 99484c71-bf34-4c10-99fc-b058170cdb03

	measure 'Target Digital Net Sales (GBP)' =
			VAR RelevantPeriods = VALUES ( dim_date[business_period_label] )
			VAR RelevantMarkets = VALUES ( dim_market[market_code] )
			RETURN
			    CALCULATE (
			        SUM ( fact_digital_targets[target_digital_net_sales_gbp] ),
			        KEEPFILTERS ( TREATAS ( RelevantPeriods, dim_period[business_period_label] ) ),
			        KEEPFILTERS ( TREATAS ( RelevantMarkets, fact_digital_targets[market_code] ) )
			    )
		formatString: "£"#,0.00
		displayFolder: Targets
		lineageTag: 8a225013-f515-42d2-b78f-94f4ad565a61

	measure 'Digital Net Sales Target Variance (GBP)' = [Digital Net Sales (GBP)] - [Target Digital Net Sales (GBP)]
		formatString: "£"#,0.00
		displayFolder: Targets
		lineageTag: 5600c63d-992a-4948-9585-a5c4820c4013

	measure 'Digital Net Sales Target Variance %' = DIVIDE ( [Digital Net Sales Target Variance (GBP)], [Target Digital Net Sales (GBP)] )
		formatString: 0.0%
		displayFolder: Targets
		lineageTag: 68b0e0cb-4c41-4e6e-b2fd-a4e87cd13df3

	measure 'Digital Net Sales Target Trend Arrow' = IF ( [Digital Net Sales Target Variance %] > 0, "▲", IF ( [Digital Net Sales Target Variance %] < 0, "▼", "▬" ) )
		displayFolder: Targets
		lineageTag: 0c0ab18e-c057-4dc9-8e48-0cc30abc365d

	measure 'Digital Net Sales Target Trend Colour' = IF ( [Digital Net Sales Target Variance %] > 0, "#2E7D32", IF ( [Digital Net Sales Target Variance %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Targets
		lineageTag: 752804fe-7e5c-4592-a97d-f820d5320b1c

	measure 'Digital Net Sales Target Combo' = [Digital Net Sales Target Trend Arrow] & " £" & FORMAT ( ABS ( [Digital Net Sales Target Variance (GBP)] ), "#,0" ) & " (" & FORMAT ( [Digital Net Sales Target Variance %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Targets
		lineageTag: 57abc8a7-f1b6-498f-91c0-f1f02d1da2ad

	measure 'Target Digital Net Sales (GBP), Any Grain' =
			SUMX (
			    dim_date,
			    VAR ThisPeriodLabel = dim_date[business_period_label]
			    VAR ThisPeriodNumber = dim_date[business_period_number]
			    VAR ThisBusinessYear = dim_date[business_year]
			    VAR ThisDayName = dim_date[day_name]
			    VAR PeriodTarget =
			        CALCULATE (
			            [Target Digital Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR PriorYearDayNameActual =
			        CALCULATE (
			            [Digital Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR PriorYearPeriodActual =
			        CALCULATE (
			            [Digital Net Sales (GBP)],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1
			        )
			    VAR PriorYearDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_number] = ThisPeriodNumber,
			            dim_date[business_year] = ThisBusinessYear - 1,
			            dim_date[day_name] = ThisDayName
			        )
			    VAR ThisPeriodDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR DayWeight =
			        IF (
			            PriorYearPeriodActual > 0,
			            DIVIDE ( PriorYearDayNameActual, PriorYearPeriodActual ),
			            DIVIDE ( 1, ThisPeriodDayCount )
			        )
			    VAR AllocatedForDayName = PeriodTarget * DayWeight
			    RETURN
			        DIVIDE ( AllocatedForDayName, IF ( PriorYearPeriodActual > 0, PriorYearDayCount, 1 ) )
			)
		formatString: "£"#,0.00
		displayFolder: Targets (Any Grain)
		lineageTag: fa1e763e-bedc-4785-9b44-4c7a55377d5d

	measure 'Digital Net Sales Target Variance (Any Grain, GBP)' = [Digital Net Sales (GBP)] - [Target Digital Net Sales (GBP), Any Grain]
		formatString: "£"#,0.00
		displayFolder: Targets (Any Grain)
		lineageTag: 475da167-de12-411d-aaec-bea55b5b987d

	measure 'Digital Net Sales Target Variance % (Any Grain)' = DIVIDE ( [Digital Net Sales Target Variance (Any Grain, GBP)], [Target Digital Net Sales (GBP), Any Grain] )
		formatString: 0.0%
		displayFolder: Targets (Any Grain)
		lineageTag: c9f3305e-a017-4f95-b2d1-544cf901e480

	measure 'Digital Net Sales Target Trend Arrow (Any Grain)' = IF ( [Digital Net Sales Target Variance % (Any Grain)] > 0, "▲", IF ( [Digital Net Sales Target Variance % (Any Grain)] < 0, "▼", "▬" ) )
		displayFolder: Targets (Any Grain)
		lineageTag: 6355e33f-911a-43c1-a7b1-43d985917bfd

	measure 'Digital Net Sales Target Trend Colour (Any Grain)' = IF ( [Digital Net Sales Target Variance % (Any Grain)] > 0, "#2E7D32", IF ( [Digital Net Sales Target Variance % (Any Grain)] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: Targets (Any Grain)
		lineageTag: 15bcc2fc-71a9-4e53-a532-e21156d4845a

	measure 'Digital Net Sales Target Combo (Any Grain)' = [Digital Net Sales Target Trend Arrow (Any Grain)] & " £" & FORMAT ( ABS ( [Digital Net Sales Target Variance (Any Grain, GBP)] ), "#,0" ) & " (" & FORMAT ( [Digital Net Sales Target Variance % (Any Grain)], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: Targets (Any Grain)
		lineageTag: a9d623ef-e8d8-4a02-8064-28d45d091e77

	column market_code
		dataType: string
		lineageTag: 140ff94d-61aa-4d31-bbfe-5044e3b9cbd0
		summarizeBy: none
		sourceColumn: market_code

	column business_year
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f7fe89c6-6810-453d-967c-2f80e57cb818
		summarizeBy: none
		sourceColumn: business_year

	column business_period_number
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ad7fc7a2-04b8-4984-a19f-d56fb374b34e
		summarizeBy: none
		sourceColumn: business_period_number

	column period_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c41e4ddf-b566-48b0-a9ad-e94244421daf
		summarizeBy: none
		sourceColumn: period_key

	column target_digital_net_sales_gbp
		dataType: double
		isHidden
		formatString: "£"#,0.00
		lineageTag: 70f2c271-3c4e-488f-9cd5-6da1460e5c9f
		summarizeBy: none
		sourceColumn: target_digital_net_sales_gbp

	partition fact_digital_targets = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents("C:\Users\tomgo\OneDrive\Documents\vscode-projects\areta-retail-analytics\data\warehouse\fact_digital_targets.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
				    Source

	annotation PBI_ResultType = Table

