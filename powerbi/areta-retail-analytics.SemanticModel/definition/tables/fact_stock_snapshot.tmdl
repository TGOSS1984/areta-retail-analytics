		lineageTag: 70a00892-ce28-4ffe-9729-ed7bf94421b1
		displayFolder: Stock

	measure 'Stock Value Retail YoY Combo' = [Stock Value Retail Trend Arrow] & " £" & FORMAT ( ABS ( [Stock Value Retail YoY (GBP)] ), "#,0.00" ) & " (" & FORMAT ( [Stock Value Retail YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 3347b857-7b18-4f35-9f9e-1478b720e783
