table fact_sales
	lineageTag: ccce2880-e748-4240-9429-05ffb06b0406

	measure 'Net Sales (GBP)' = SUM ( fact_sales[net_sales_gbp] )
		formatString: "£"#,0.00
		displayFolder: Sales & Margin
		lineageTag: 024b0bd8-fd47-487c-ac8d-b517b530f46e

	measure 'Gross Cost (GBP)' = SUM ( fact_sales[cost_gbp] )
