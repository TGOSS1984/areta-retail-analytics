table fact_digital_sales
	lineageTag: 2ad09c39-2870-45e4-bb1f-20a71fa69675

	measure 'Digital Orders' = SUM ( fact_digital_sales[orders] )
		formatString: #,0
		displayFolder: Digital
		lineageTag: 5baee575-c310-43da-91bc-99975746ce52

	measure 'Digital Units' = SUM ( fact_digital_sales[units] )
		formatString: #,0
		displayFolder: Digital
		lineageTag: df12ab4d-d8e8-49a1-b9f6-7d26b297487c

	measure 'Digital Net Sales (GBP)' = SUM ( fact_digital_sales[net_sales_gbp] )
		formatString: "£"#,0.00
		displayFolder: Digital
		lineageTag: be573ac3-36a8-4a43-8c12-361b2db0dd6b

	measure 'Average Basket Value (GBP)' = DIVIDE ( [Digital Net Sales (GBP)], [Digital Orders] )
		formatString: "£"#,0.00
		displayFolder: Digital
		lineageTag: 7d9fd329-9b3e-4611-bacf-b5c2f758e3b1

