table fact_digital_sales
	lineageTag: 2ad09c39-2870-45e4-bb1f-20a71fa69675

	column date
		dataType: dateTime
		isHidden
		lineageTag: f07e7591-bd39-4e3b-92c7-ccad63f47958
		summarizeBy: none
		sourceColumn: date

	column market_code
		dataType: string
		lineageTag: a6f272e9-6b0a-4608-a482-d994c7241f6e
		summarizeBy: none
		sourceColumn: market_code

	column device_type
		dataType: string
		lineageTag: f5642598-1319-4185-8066-7da9d2df519e
		summarizeBy: none
		sourceColumn: device_type

	column orders
		dataType: int64
		formatString: #,0
		lineageTag: 88b852fe-cc5b-44ac-9697-ae34728d7f11
		summarizeBy: none
		sourceColumn: orders

	column units
		dataType: int64
		formatString: #,0
		lineageTag: 339acdc0-8022-47ae-b471-9c5472888c8a
		summarizeBy: none
		sourceColumn: units

	column net_sales_gbp
		dataType: double
		formatString: "£"#,0.00
		lineageTag: 73ec5e08-40de-44c3-a2ee-a4ae853ad915
		summarizeBy: none
		sourceColumn: net_sales_gbp

	column basket_value_gbp
		dataType: double
		formatString: "£"#,0.00
		lineageTag: 9dd35372-1508-440b-a5ef-139901551b31
		summarizeBy: none
		sourceColumn: basket_value_gbp

	measure 'Digital Orders' = SUM ( fact_digital_sales[orders] )
		formatString: #,0
		lineageTag: 5baee575-c310-43da-91bc-99975746ce52
		displayFolder: Digital

	measure 'Digital Units' = SUM ( fact_digital_sales[units] )
		formatString: #,0
		lineageTag: df12ab4d-d8e8-49a1-b9f6-7d26b297487c
		displayFolder: Digital

	measure 'Digital Net Sales (GBP)' = SUM ( fact_digital_sales[net_sales_gbp] )
		formatString: "£"#,0.00
		lineageTag: be573ac3-36a8-4a43-8c12-361b2db0dd6b
		displayFolder: Digital

	measure 'Average Basket Value (GBP)' = DIVIDE ( [Digital Net Sales (GBP)], [Digital Orders] )
		formatString: "£"#,0.00
		lineageTag: 7d9fd329-9b3e-4611-bacf-b5c2f758e3b1
		displayFolder: Digital

	measure 'Digital Net Sales LY' =
			CALCULATE (
			    [Digital Net Sales (GBP)],
			    FILTER ( ALL ( dim_date[business_year] ), dim_date[business_year] = MAX ( dim_date[business_year] ) - 1 )
			)
		formatString: "£"#,0.00
		lineageTag: 7c6d7b79-0e79-4fd3-ba0d-94b8b1679d6d
		displayFolder: Time Intelligence

	measure 'Digital Net Sales YoY (GBP)' = [Digital Net Sales (GBP)] - [Digital Net Sales LY]
		formatString: "£"#,0.00
		lineageTag: 0571a404-0d89-4981-b044-c98b8c469f9e
		displayFolder: Time Intelligence

	measure 'Digital Net Sales YoY %' = DIVIDE ( [Digital Net Sales (GBP)] - [Digital Net Sales LY], [Digital Net Sales LY] )
		formatString: 0.0%
		lineageTag: c75a8a4f-ac1f-48ca-8605-94f03c415acb
		displayFolder: Time Intelligence

	measure 'Digital Net Sales Trend Arrow' = IF ( [Digital Net Sales YoY %] > 0, "▲", IF ( [Digital Net Sales YoY %] < 0, "▼", "▬" ) )
		formatString: Time Intelligence
		lineageTag: 2b7840e0-9486-4e8b-9724-ff15f29b45cd
		displayFolder: Time Intelligence

	measure 'Digital Net Sales Trend Colour' = IF ( [Digital Net Sales YoY %] > 0, "#2E7D32", IF ( [Digital Net Sales YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		formatString: Time Intelligence
		lineageTag: 34e6f695-e4a2-4d80-b77e-1b57b491671a
		displayFolder: Time Intelligence

	measure 'Digital Net Sales YoY Combo' = [Digital Net Sales Trend Arrow] & " £" & FORMAT ( ABS ( [Digital Net Sales YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Digital Net Sales YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: b1a28ce7-86e2-4646-800e-0405b7ac58c8
		displayFolder: Time Intelligence

	measure 'Average Basket Value LY' =
			CALCULATE (
			    [Average Basket Value (GBP)],
			    FILTER ( ALL ( dim_date[business_year] ), dim_date[business_year] = MAX ( dim_date[business_year] ) - 1 )
			)
		formatString: "£"#,0.00
		lineageTag: e3e5ef6d-da93-462c-8112-cc95911aa332
		displayFolder: Time Intelligence

	measure 'Average Basket Value YoY (GBP)' = [Average Basket Value (GBP)] - [Average Basket Value LY]
		formatString: "£"#,0.00
		lineageTag: a95b3cc2-47bc-42a9-83a5-b8fb899a7657
		displayFolder: Time Intelligence

	measure 'Average Basket Value YoY %' = DIVIDE ( [Average Basket Value (GBP)] - [Average Basket Value LY], [Average Basket Value LY] )
		formatString: 0.0%
		lineageTag: 4fe594a7-b113-4c40-9746-d153e4542a2f
		displayFolder: Time Intelligence

	measure 'Average Basket Value Trend Arrow' = IF ( [Average Basket Value YoY %] > 0, "▲", IF ( [Average Basket Value YoY %] < 0, "▼", "▬" ) )
		formatString: Time Intelligence
		lineageTag: a63f6cd1-cd03-4ba0-981a-a80842f18d3f
		displayFolder: Time Intelligence

	measure 'Average Basket Value Trend Colour' = IF ( [Average Basket Value YoY %] > 0, "#2E7D32", IF ( [Average Basket Value YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		formatString: Time Intelligence
		lineageTag: 29fa1120-5974-4cb4-8e85-bdf0a78292f8
		displayFolder: Time Intelligence

	measure 'Average Basket Value YoY Combo' = [Average Basket Value Trend Arrow] & " £" & FORMAT ( ABS ( [Average Basket Value YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Average Basket Value YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		lineageTag: 6e5f4de8-f48c-4096-a487-be01134f22b2
		displayFolder: Time Intelligence

	partition fact_digital_sales = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents("C:\Users\tomgo\OneDrive\Documents\vscode-projects\areta-retail-analytics\data\warehouse\fact_digital_sales.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
				    Source

	annotation PBI_ResultType = Table
