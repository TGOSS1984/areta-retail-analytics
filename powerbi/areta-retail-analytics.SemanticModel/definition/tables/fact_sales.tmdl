		displayFolder: KPI Trend Indicators
		lineageTag: 4861f910-090d-4e9b-8751-52d09c643003

	/// One style = one style_code. I clear style_name and style_label as well as
	/// style_code because a filter on either survives ALL(style_code) on its own and
	/// quietly ranks each style against only the styles sharing its name. Blank when
	/// more than one style is in context, so a style_name axis shows nothing instead
	/// of a wrong line.
	measure 'Style Pareto Rank' =
			IF (
			    HASONEVALUE ( dim_product[style_code] ),
			    RANKX (
			        ALL ( dim_product[style_code], dim_product[style_name], dim_product[style_label] ),
			        [Net Sales (GBP)],
			        ,
			        DESC,
			        Dense
			    )
			)
		formatString: #,0
		displayFolder: Pareto Analysis
		lineageTag: 90230b81-c33d-4621-8ede-9bcc3ccbd24c

	/// Sums every style selling at least as much as this one. Same result as
	/// "rank <= my rank" but it scores each style once instead of re-running RANKX
	/// inside the filter for every style, roughly 800k evaluations per bar.
	measure 'Style Pareto Cumulative Sales (GBP)' =
			VAR CurrentSales = [Net Sales (GBP)]
			VAR StyleSales =
			    ADDCOLUMNS (
			        ALL ( dim_product[style_code], dim_product[style_name], dim_product[style_label] ),
			        "@Sales", [Net Sales (GBP)]
			    )
			RETURN
			    IF (
			        HASONEVALUE ( dim_product[style_code] ) && NOT ISBLANK ( CurrentSales ),
			        SUMX ( FILTER ( StyleSales, [@Sales] >= CurrentSales ), [@Sales] )
			    )
		formatString: "£"#,0.00
		displayFolder: Pareto Analysis
		lineageTag: cf71f7b9-5bf2-44df-bc0e-f1174d2d42c1

