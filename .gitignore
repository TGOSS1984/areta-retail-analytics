# Power BI
*.pbix
~$*.pbix
.pbi/cache/

# Generated data — regenerate via generator/, don't bloat the repo.
# data/warehouse and data/exports stay tracked; they're the actual
# deliverable the report and web app read from.
data/raw/
data/staging/

# web/public/data is synced from data/exports/ automatically by
# scripts/sync-data.mjs (predev/prebuild) — regenerated on every run,
# no reason to commit a duplicate copy of the same files
web/public/data/*.parquet