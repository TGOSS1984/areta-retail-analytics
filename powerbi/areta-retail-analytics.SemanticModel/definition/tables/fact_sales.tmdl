	measure 'VAT Multiplier' =
			DIVIDE ( [Gross Sales inc. VAT (GBP)], [Net Sales (GBP)], 1 )
		formatString: 0.000
		lineageTag: ff3def85-3db2-430b-a3c2-cc96371da71e
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View)' =
			SWITCH (
			    SELECTEDVALUE ( dim_vat_view[vat_view], "Excluding VAT" ),
			    "Including VAT", [Gross Sales inc. VAT (GBP)],
			    [Net Sales (GBP)]
			)
		formatString: "£"#,0.00
		lineageTag: df9c871a-6f35-41a7-b270-d2bc0aa7946f
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) LY' =
			VAR CurrentYear = MAX ( dim_date[business_year] )
			VAR RelevantPeriodNumbers = VALUES ( dim_date[business_period_number] )
			VAR RelevantWeekNumbers = VALUES ( dim_date[business_week_number] )
			RETURN
			    CALCULATE (
			        [Net Sales (Selected VAT View)],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[business_year] = CurrentYear - 1,
			        TREATAS ( RelevantPeriodNumbers, dim_date[business_period_number] ),
			        TREATAS ( RelevantWeekNumbers, dim_date[business_week_number] )
			    )
		formatString: "£"#,0.00
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) YoY (GBP)' =
			[Net Sales (Selected VAT View)] - [Net Sales (Selected VAT View) LY]
		formatString: "£"#,0.00
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) YoY %' =
			DIVIDE ( [Net Sales (Selected VAT View)] - [Net Sales (Selected VAT View) LY], [Net Sales (Selected VAT View) LY] )
		formatString: 0.0%
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Trend Arrow' =
			IF ( [Net Sales (Selected VAT View) YoY %] > 0, "▲", IF ( [Net Sales (Selected VAT View) YoY %] < 0, "▼", "▬" ) )
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) Trend Colour' =
			IF ( [Net Sales (Selected VAT View) YoY %] > 0, "#2E7D32", IF ( [Net Sales (Selected VAT View) YoY %] < 0, "#D32F2F", "#8D9AA1" ) )
		displayFolder: VAT View

	measure 'Net Sales (Selected VAT View) YoY Combo' =
			[Net Sales (Selected VAT View) Trend Arrow] & " £" & FORMAT ( ABS ( [Net Sales (Selected VAT View) YoY (GBP)] ), "#,0" ) & " (" & FORMAT ( [Net Sales (Selected VAT View) YoY %], "+0.0%;-0.0%;0.0%" ) & ")"
		displayFolder: VAT View

	column 'Discount Band' =
			SWITCH (
			    TRUE (),
			    fact_sales[promo_id] = "PROMO0000", "Full Price",
			    LEFT ( fact_sales[promo_id], 9 ) = "MULTIBUY-", "Multi-buy",
			    fact_sales[discount_pct] <= 30, "Up to 30% off",
			    fact_sales[discount_pct] <= 50, "31-50% off",
			    fact_sales[discount_pct] <= 70, "51-70% off",
			    "70%+ off"
			)
		dataType: string
		lineageTag: 35c68076-1cb0-4aec-affe-eccd70ff6a6e
		summarizeBy: none

	partition fact_sales = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents("C:\Users\tomgo\OneDrive\Documents\vscode-projects\areta-retail-analytics\data\warehouse\fact_sales.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
				    Source

	annotation PBI_ResultType = Table

