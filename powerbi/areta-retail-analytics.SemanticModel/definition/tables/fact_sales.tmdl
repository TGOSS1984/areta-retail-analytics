	/// The best-selling product group in the current filter context, as text, for the
	/// Categories page's "Top category" card. I first built that card from the
	/// product_group column with a Top N visual filter, but the new card visual gave a
	/// text column a narrow slot and cut the name off. A measure renders as the
	/// callout value and uses the card's full width.
	measure 'Top Product Group' =
			VAR GroupSales =
			    ADDCOLUMNS ( VALUES ( dim_product[product_group] ), "@Sales", [Net Sales (GBP)] )
			RETURN
			    IF (
			        NOT ISBLANK ( [Net Sales (GBP)] ),
			        MAXX ( TOPN ( 1, GroupSales, [@Sales], DESC ), dim_product[product_group] )
			    )
		displayFolder: Pareto Analysis
		lineageTag: 32c703cb-0259-40f2-88b8-8ac37c2bd3d7

	/// The top group's share of Net Sales in the same context. Goes on the same card
	/// as its reference label.
	measure 'Top Product Group Share %' =
			VAR GroupSales =
			    ADDCOLUMNS ( VALUES ( dim_product[product_group] ), "@Sales", [Net Sales (GBP)] )
			RETURN
			    DIVIDE ( MAXX ( GroupSales, [@Sales] ), [Net Sales (GBP)] )
		formatString: 0.0%
		displayFolder: Pareto Analysis
		lineageTag: 62548630-67e6-48c8-bee3-b82a04ce9541

	/// Same idea as Top Product Group, one level down. It ranks on style_code, not
	/// style_name, because 907 styles share 498 names across the brands; ranking by
	/// name would add unrelated styles together. It then shows the winning style's
	/// name, since the code means nothing on a card.
	measure 'Top Style' =
			VAR StyleSales =
			    ADDCOLUMNS ( VALUES ( dim_product[style_code] ), "@Sales", [Net Sales (GBP)] )
			VAR TopCode =
			    MAXX ( TOPN ( 1, StyleSales, [@Sales], DESC ), dim_product[style_code] )
			RETURN
			    IF (
			        NOT ISBLANK ( [Net Sales (GBP)] ),
			        LOOKUPVALUE ( dim_product[style_name], dim_product[style_code], TopCode )
			    )
		displayFolder: Pareto Analysis
		lineageTag: 29007167-e1a9-4de4-9632-9c83e1bdbdbe

	/// The top style's share of Net Sales in the same context, for the reference label.
	measure 'Top Style Share %' =
			VAR StyleSales =
			    ADDCOLUMNS ( VALUES ( dim_product[style_code] ), "@Sales", [Net Sales (GBP)] )
			RETURN
			    DIVIDE ( MAXX ( StyleSales, [@Sales] ), [Net Sales (GBP)] )
		formatString: 0.0%
		displayFolder: Pareto Analysis
		lineageTag: fe97a040-fa71-4ec7-96ee-a37fe7c3bee8

