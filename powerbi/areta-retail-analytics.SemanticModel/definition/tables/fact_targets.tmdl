	measure 'Gross Margin Target Combo (Any Grain)' = [Gross Margin Target Trend Arrow (Any Grain)] & " " & FORMAT ( [Gross Margin Target Variance (Any Grain, pp)] * 100, "+0.0pp;-0.0pp;0.0pp" )
		displayFolder: Targets (Any Grain)
		lineageTag: 95564ae9-487e-46d1-bd71-9c0553d7d1b7

