	measure 'P&L Bridge Value' =
			SWITCH (
			    SELECTEDVALUE ( dim_pnl_bridge[step_name] ),
			    "Net Sales", [Net Sales (GBP)],
			    "Cost of Goods", -[Gross Cost (GBP)],
			    "Gross Profit", [Gross Profit (GBP)],
