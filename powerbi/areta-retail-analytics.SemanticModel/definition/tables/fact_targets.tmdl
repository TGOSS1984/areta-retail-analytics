			    VAR ThisPeriodDayCount =
			        CALCULATE (
			            DISTINCTCOUNT ( dim_date[full_date] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[business_period_label] = ThisPeriodLabel
			        )
			    VAR DayWeight =
			        IF (
			            PriorYearPeriodActual > 0,
			            DIVIDE ( PriorYearDayNameActual, PriorYearPeriodActual ),
			            DIVIDE ( 1, ThisPeriodDayCount )
			        )
			    VAR AllocatedForDayName = PeriodTarget * DayWeight
			    RETURN
			        DIVIDE ( AllocatedForDayName, IF ( PriorYearPeriodActual > 0, PriorYearDayCount, 1 ) )
			)
		formatString: #,0
		lineageTag: fdac0583-2f63-4671-afaa-3ae78601e187
		displayFolder: Targets (Any Grain)

	measure 'Total Footfall Target Variance (Any Grain)' =
			[Total Footfall] - [Target Total Footfall, Any Grain]
		formatString: #,0
		lineageTag: 4a7c53c4-0510-4ef7-aeda-bf0c33e30735
		displayFolder: Targets (Any Grain)

	measure 'Total Footfall Target Variance % (Any Grain)' =
			DIVIDE ( [Total Footfall Target Variance (Any Grain)], [Target Total Footfall, Any Grain] )
		formatString: 0.0%
		lineageTag: 5c6bff0c-999f-4c02-ae10-c527c4c18a67
		displayFolder: Targets (Any Grain)

	measure 'Total Footfall Target Trend Arrow (Any Grain)' =
			IF ( [Total Footfall Target Variance % (Any Grain)] > 0, "▲", IF ( [Total Footfall Target Variance % (Any Grain)] < 0, "▼", "▬" ) )
		lineageTag: 61368eb8-8178-4500-b74c-5fb2357f34d2
		displayFolder: Targets (Any Grain)

	measure 'Total Footfall Target Trend Colour (Any Grain)' =
			IF ( [Total Footfall Target Variance % (Any Grain)] > 0, "#2E7D32", IF ( [Total Footfall Target Variance % (Any Grain)] < 0, "#D32F2F", "#8D9AA1" ) )
		lineageTag: 75289085-024e-4711-a3e5-5a415a645a67
		displayFolder: Targets (Any Grain)

	measure 'Total Footfall Target Combo (Any Grain)' =
			[Total Footfall Target Trend Arrow (Any Grain)] & " " & FORMAT ( ABS ( [Total Footfall Target Variance (Any Grain)] ), "#,0" ) & " (" & FORMAT ( [Total Footfall Target Variance % (Any Grain)], "+0.0%;-0.0%;0.0%" ) & " to target)"
		lineageTag: 5f4862eb-0914-48f0-8622-b3e39f0ecc40
		displayFolder: Targets (Any Grain)

	partition fact_targets = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents("C:\Users\tomgo\OneDrive\Documents\vscode-projects\areta-retail-analytics\data\warehouse\fact_targets.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
				    Source

	annotation PBI_ResultType = Table

