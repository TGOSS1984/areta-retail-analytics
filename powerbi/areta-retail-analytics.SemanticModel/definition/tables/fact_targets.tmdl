	measure 'Target Gross Margin %, Any Grain' =
			// The margin target is a rate for the period, so it is the same on every day of that period.
			// Same as the plain measure (checked: identical at day, week, period and year), kept here so the Any Grain set is complete.
			[Target Gross Margin %]
