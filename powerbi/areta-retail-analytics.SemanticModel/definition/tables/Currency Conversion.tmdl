table 'Currency Conversion'
	lineageTag: 880e9f95-4c3c-4fd5-8170-514648921420

	calculationGroup
		precedence: 10

		calculationItem 'Local Currency (GBP)' = SELECTEDMEASURE ( )

		calculationItem 'Selected Currency' =
				IF (
				    CONTAINSSTRING ( SELECTEDMEASUREFORMATSTRING ( ), "£" ),
				    SELECTEDMEASURE ( ) * [FX Rate (Selected)],
				    SELECTEDMEASURE ( )
				)

	column 'Currency Conversion'
		dataType: string
		lineageTag: c69aa377-61a2-4874-8008-c08e5971189d
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: 19c6411b-7f4f-4268-8264-cc7af5d1e22c
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

