model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_date","dim_period","dim_product","dim_promo","dim_currency","fact_sales","fact_footfall","fact_stock_snapshot","fact_targets","fact_store_finance","fx_rate_monthly","dim_store","dim_market","fact_digital_sales","fact_digital_traffic"]

ref table dim_date
ref table dim_period
ref table dim_product
ref table dim_promo
ref table dim_currency
ref table fact_sales
ref table fact_footfall
ref table fact_stock_snapshot
ref table fact_targets
ref table fact_store_finance
ref table fx_rate_monthly
ref table dim_store
ref table dim_market
ref table fact_digital_sales
ref table fact_digital_traffic

ref cultureInfo en-GB

